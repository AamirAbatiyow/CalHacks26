{
  "name": "ground-truth-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Runs System 1, System 2 and retraining outside SpacetimeDB and writes results back through reducers",
  "scripts": {
    "start": "tsx src/index.ts",
    "seed-history": "tsx src/seedHistory.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "generate": "spacetime generate --lang typescript --out-dir ./src/module_bindings --module-path ../server/spacetimedb -y"
  },
  "dependencies": {
    "spacetimedb": "^2.13.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  }
}
